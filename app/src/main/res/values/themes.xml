<resources>
    <!-- Material 3 with Material You dynamic colour (Android 12+); baseline palette otherwise. -->
    <style name="Theme.Calculator" parent="Theme.Material3.DayNight.NoActionBar" />

    <style name="CalcKey" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="cornerRadius">36dp</item>
        <item name="backgroundTint">?attr/colorSurfaceContainerHigh</item>
    </style>
    <style name="CalcKey.Function">
        <item name="android:textColor">?attr/colorOnSecondaryContainer</item>
        <item name="backgroundTint">?attr/colorSecondaryContainer</item>
    </style>
    <style name="CalcKey.Operator">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="backgroundTint">?attr/colorPrimary</item>
    </style>
</resources>
